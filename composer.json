{
  "name": "oliverde8/comfy-bundle",
  "type": "library",
  "description": "Add administrable configuration that users/admin can edit on the run.",
  "license": "MIT",
  "authors": [
    {
      "name": "Oliver de Cramer",
      "homepage": "http://oliver-decramer.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "symfony/framework-bundle": "^5.0|^6.0|^7.0|^8.0",
    "symfony/form": "*",
    "oliverde8/associative-array-simplified": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "oliverde8\\ComfyBundle\\": "."
    },
    "exclude-from-classmap": [
      "/Tests/"
    ]
  },
  "require-dev": {
    "rector/rector": "^2.3",
    "phpunit/phpunit": "^11.0",
    "symfony/validator": "^6.4|^7.0|^8.0",
    "symfony/intl": "^6.4|^7.0|^8.0"
  },
  "autoload-dev": {
    "psr-4": {
      "oliverde8\\ComfyBundle\\Tests\\": "Tests/"
    }
  }
}
